# Contact inquiry email — server only, never exposed to the browser.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must therefore never hold a real value.

# Google Workspace SMTP, used to send inquiry notifications. The password is an
# app password generated for this site specifically, not the account password —
# it authorises SMTP alone and can be revoked on its own.
SMTP_USER=info@riemlabs.dev
SMTP_APP_PASSWORD=

# Where inquiries arrive. The authenticated mailbox is also the sender, so for
# now this is the same address.
INQUIRY_TO_EMAIL=info@riemlabs.dev

# ---------------------------------------------------------------------------
# Superseded by the SMTP variables above, and kept only until the new transport
# has been proven in production. Nothing in the app reads them any more.
#
# HOSTINGER_MAIL_API_TOKEN=
# HOSTINGER_MAILBOX_ID=
