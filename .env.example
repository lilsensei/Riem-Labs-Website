# Contact inquiry email — server only, never exposed to the browser.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must therefore never hold a real value.

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# The address inquiries are sent FROM. Must be on a domain verified in Resend,
# otherwise the send is rejected. e.g. inquiries@riemlabs.dev
INQUIRY_FROM_EMAIL=

# Where inquiries arrive.
INQUIRY_TO_EMAIL=info@riemlabs.dev
