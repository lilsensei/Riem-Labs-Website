# Contact inquiry email — server only, never exposed to the browser.
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must therefore never hold a real value.

# Hostinger Mail API token, from hPanel. Authorises one managed mailbox.
HOSTINGER_MAIL_API_TOKEN=

# Resource ID of that mailbox. Resolve it with the token against
# GET https://api.mail.hostinger.com/api/v1/me — the response lists each
# mailbox as { resourceId, address }; take the one whose address matches.
HOSTINGER_MAILBOX_ID=

# Where inquiries arrive. The managed mailbox is also the sender, so for now
# this is the same address.
INQUIRY_TO_EMAIL=info@riemlabs.dev
